---
import { getImage } from 'astro:assets';

// components
import CustomCursor from '../../components/CustomCursor/CustomCursor.astro';

// images
import faviconSvgSrc from '../../images/favicon.svg';
import noiseGif from '../../images/noise.gif';

// styles
import '../../../styles/global.css';

const faviconSvg = await getImage({ src: faviconSvgSrc, format: 'svg' });

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "I'm Harry, a software engineer and TanStack maintainer. I build tools, teams, and occasionally climb stuff.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);
const ogImageAlt = "I'm Harry, written above a contour-lined render of the moon.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={faviconSvg.src} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Harry Whorlow" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Harry Whorlow" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>

  <body data-overlayscrollbars-initialize>
    <main class="min-h-screen">
      <CustomCursor />
      <div id="noise-overlay" style={`background-image: url('${noiseGif.src}')`}></div>

      <div id="smooth-wrapper">
        <div id="smooth-content">
          <slot />
        </div>
      </div>
    </main>
  </body>
</html>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import ScrollSmoother from 'gsap/ScrollSmoother';

  import 'overlayscrollbars/overlayscrollbars.css';
  import { OverlayScrollbars } from 'overlayscrollbars';

  OverlayScrollbars(document.body, {
    scrollbars: {
      theme: 'os-theme-difference',
    },
  });

  gsap.registerPlugin(ScrollTrigger, ScrollSmoother);
  ScrollTrigger.normalizeScroll(true);

  ScrollSmoother.create({
    wrapper: '#smooth-wrapper',
    content: '#smooth-content',
    smooth: 2,
    effects: true,
  });
</script>

<style is:global>
  :root {
    --grey-dark-main: rgb(31, 33, 36);
    --grey-dark-light: rgb(40, 43, 48);

    --grey-light-main: rgb(234, 234, 234);

    --main-text-light: rgb(234, 234, 234);
    --main-text-dark: rgb(31, 33, 36);

    --accent-primary: rgb(60, 134, 147);
  }

  * {
    box-sizing: border-box;

    cursor: none;
  }

  html {
    background-color: #fff;
  }

  main {
    min-height: 100vh;
  }

  #noise-overlay {
    position: fixed;
    inset: 0;

    background-size: 80px;
    opacity: 0.1;

    z-index: 40;
    pointer-events: none;
  }

  .actionable {
    z-index: 50;
  }

  .os-scrollbar.os-theme-difference {
    --os-size: 10px;
    --os-padding-perpendicular: 2px;
    --os-padding-axis: 2px;
    --os-handle-border-radius: 10px;
    --os-handle-bg: #fff;
    --os-handle-bg-hover: #fff;
    --os-handle-bg-active: #fff;

    mix-blend-mode: difference;
  }
</style>

---
import { getImage } from 'astro:assets';

import CustomCursor from './components/CustomCursor/CustomCursor.astro';
import Estd from './components/Estd/Estd.astro';

import faviconSvgSrc from '../images/favicon.svg';

import '../styles/global.css';

const faviconSvg = await getImage({ src: faviconSvgSrc, format: 'svg' });

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Portfolio site for yours truly" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={faviconSvg.src} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body data-overlayscrollbars-initialize>
    <main class="min-h-screen">
      <CustomCursor />

      <Estd />

      <div class="h-full" id="smooth-wrapper">
        <div class="h-full" id="smooth-content">
          <slot />
        </div>
      </div>
    </main>
  </body>
</html>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import ScrollSmoother from 'gsap/ScrollSmoother';

  import 'overlayscrollbars/overlayscrollbars.css';
  import { OverlayScrollbars } from 'overlayscrollbars';

  OverlayScrollbars(document.body, {
    scrollbars: {
      theme: 'os-theme-dark',
    },
  });

  gsap.registerPlugin(ScrollTrigger, ScrollSmoother);
  ScrollTrigger.normalizeScroll(true);

  ScrollSmoother.create({
    wrapper: '#smooth-wrapper',
    content: '#smooth-content',
    smooth: 2,
    effects: true,
  });
</script>

<style is:global>
  :root {
    --grey-dark-main: rgb(31, 33, 36);
    --grey-dark-light: rgb(40, 43, 48);

    --grey-light-main: rgb(234, 234, 234);

    --main-text-light: rgb(234, 234, 234);
    --main-text-dark: rgb(31, 33, 36);

    --accent-primary: rgb(60, 134, 147);
  }

  * {
    box-sizing: border-box;

    cursor: none;
  }

  main {
    min-height: 100vh;
  }

  .actionable {
    z-index: 50;

    position: relative;
  }

  .in-actionable {
    /* pointer-events: none; */
  }
</style>

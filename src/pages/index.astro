---
import Body from '../layouts/Body/Body.astro';

import TextScroller from '../components/TextScroller/index.astro';
import HorizontalProgress from '../components/HorizontalProgress/index.astro';
import ExperienceTimeline from '../components/ExperienceTimeline/index.astro';
import Job from '../components/ExperienceTimeline/Job.astro';

import { RAMP } from '../three/palette';

// low, mid and high elevation
const progressColors = [RAMP[2], RAMP[4], RAMP[6]];
---

<Body title="Projekt Neu | Harry Whorlow">
  <div class="theme" data-theme="dark">
    <section id="first-section" class="first-section relative h-screen w-full overflow-hidden">
      <canvas id="moon-canvas" class="block h-full w-full" />

      <div class="pointer-events-none absolute top-0 left-0 p-8 md:p-12">
        <h1 class="text-[10rem] leading-none font-bold">I'm Harry,</h1>
        <p class="mt-4 text-base">I build tools, teams, and occasionally climb stuff.</p>
      </div>

      <HorizontalProgress colors={progressColors} />
    </section>

    <div id="second-section">
      <section class="flex min-h-screen flex-col">
        <TextScroller />

        <div class="p-10">
          <h1 class="mt-10 text-[10rem] leading-none font-bold">Open Source</h1>

          <p class="mt-4 w-200 text-base">
            I'm a maintainer for <span class="text-low">TanStack</span>, with contributions across all of our libraries,
            though you'll find I spend a lot of time in <span class="text-mid">Form</span> and{' '}
            <span class="text-high">Devtools</span> realm. I've also contributed to MUI, the e18e community, and Neon
            along the way.
          </p>
        </div>
      </section>
    </div>

    <div id="third-section">
      <section class="flex min-h-screen flex-col">
        <ExperienceTimeline colors={[RAMP[2], RAMP[4], RAMP[6]]}>
          <Job company="AllMyHomes" dates="01/05/22 - 17/07/22">
            <p>
              The biggest lesson I took from this role was patience and compassion for a fellow developer. My senior,
              Lukas, is someone I'm still grateful to. When I was tasked with migrating my three repos into a monorepo,
              he told me to "just copy over the APIs," so I did, literally. Thirteen thousand lines, Ctrl+C, Ctrl+V. (I
              still cringe thinking about it.) My bootcamp had never covered micro-frontends or monoliths, and when he
              said he'd speak to my skip-level manager, I was sure I was finished. Instead, I was given training to get
              up to speed. I'm not the greatest developer in the world, but I'm now a competent one, and I owe much of
              that to Lukas for having the patience and giving me another chance.
            </p>
          </Job>

          <Job company="Technoly" dates="01/09/22 - PRESENT">
            <p>
              Technoly is where I really progressed as a developer. I was given the freedom to make mistakes and had
              very little oversight for the majority of my time here. Decisions I made years ago as a junior developer
              frequently show up again in tasks I have today. I feel that oftentimes we learn the most as developers
              when we are confronted with decisions we made in the past, a lesson that many developers are robbed of if
              their time at a company is on the shorter side. Consequently, I have learnt a lot here: I have become
              confident in my developer skills, deepened my understanding of advanced TypeScript, and even became a
              maintainer of TanStack, an organisation I once revered and still do.
            </p>
          </Job>

          <Job company="TO BE CONTINUED..." dates="PRESENT - FUTURE">
            <p>My story is still developing, lets see where I go next.</p>
          </Job>
        </ExperienceTimeline>
      </section>
    </div>

    <div id="forth-section">
      <section class="flex min-h-screen flex-col"></section>
    </div>
  </div>

  <style>
    .theme {
      --theme-bg: #000;
      --theme-fg: var(--main-text-light);

      background-color: var(--theme-bg);
      color: var(--theme-fg);
      transition:
        background-color 0.6s ease,
        color 0.6s ease;
    }

    .theme[data-theme='light'] {
      --theme-bg: var(--grey-light-main);
      --theme-fg: var(--main-text-dark);
    }

    #second-section {
    }
    #third-section {
    }
    #forth-section {
      opacity: 0;
    }
  </style>

  <script>
    import gsap from 'gsap';
    import ScrollTrigger from 'gsap/ScrollTrigger';

    import { createMoon } from '../three/moon';

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener('DOMContentLoaded', () => {
      const canvas = document.querySelector<HTMLCanvasElement>('#moon-canvas');
      const moon = canvas && createMoon(canvas);
      const theme = document.querySelector<HTMLElement>('.theme')!;
      const setTheme = (value: 'dark' | 'light') => (theme.dataset.theme = value);

      // one scrubbed timeline drives the pin, so the copy, the bars and the theme flip can't drift apart
      const intro = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: '.first-section',
          start: 'top top',
          end: '+=150%',
          pin: true,
          scrub: true,
          invalidateOnRefresh: true,
          onUpdate: (self) => moon?.setScroll(self.progress),
          // the last bar reaches the right edge exactly as the pin ends
          onLeave: () => setTheme('light'),
          onEnterBack: () => setTheme('dark'),
        },
      });

      // move the hero copy up off-screen in step with the pinned moon animation
      intro.to(
        '.hero-copy',
        {
          y: () => {
            const copy = document.querySelector<HTMLElement>('.hero-copy');
            return copy ? -(copy.offsetTop + copy.offsetHeight) : 0;
          },
          duration: 1,
        },
        0
      );

      // staggered so the bars arrive one after another, together spanning the whole pin
      intro.to('.progress-bar', { scaleX: 1, duration: 0.8, stagger: 0.1 }, 0);

      gsap.to('#overlay-secondary', {
        opacity: 1,
        scrollTrigger: {
          trigger: '.second-section',
          start: 'top bottom',
          end: 'top center',
          scrub: true,
        },
      });
    });
  </script>
</Body>

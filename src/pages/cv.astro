---
import Body from '../layouts/Body/Body.astro';
import Actionable from '../components/Actionable/index.astro';
---

<Body title="Projekt Neu | Harry Whorlow">
  <div class="flex flex-col items-center justify-center min-h-screen p-6 md:p-10">
    <section class="flex flex-col gap-6 items-center">
      <h1 class="font-bold text-4xl sm:text-5xl md:text-7xl lg:text-8xl text-center">Big Data is watching YOU</h1>

      <div class="flex flex-col md:flex-row gap-4 mt-6 md:mt-10 w-full max-w-5xl justify-center">
        <Actionable xActionableOffset={10} yActionableOffset={10}>
          <a
            class="flex flex-col items-center p-5 border border-gray-300 rounded-lg bg-transparent transition-shadow hover:shadow-md hover:shadow-gray-400/40 w-full md:w-auto"
            href="/cv/harry-whorlow.humans.cv.pdf"
            download>
            <h2 class="mb-2 font-bold text-2xl sm:text-3xl md:text-5xl text-center">Humans.cv</h2>
            <span class="text-sm sm:text-base text-center">Organic - No updates available.</span>
          </a>
        </Actionable>

        <Actionable xActionableOffset={10} yActionableOffset={10}>
          <a
            class="flex flex-col items-center p-5 border border-gray-300 rounded-lg bg-transparent transition-shadow hover:shadow-md hover:shadow-gray-400/40 w-full md:w-auto"
            href="/cv/harry-whorlow.machines.cv.pdf"
            download>
            <h2 class="mb-2 font-bold text-2xl sm:text-3xl md:text-5xl text-center">Robots.cv</h2>
            <span class="text-sm sm:text-base text-center">Soulless - The robots (ATS) will be happy.</span>
          </a>
        </Actionable>
      </div>
    </section>
  </div>

  <style>
    #overlay-base {
      background-color: var(--grey-light-main);
    }
  </style>
</Body>

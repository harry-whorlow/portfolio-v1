---
import Layout from '../layouts/Layout.astro';
import Actionable from '../components/Actionable/index.astro';
---

<Layout title="Projekt Neu | Harry Whorlow">
  <div class="flex flex-col items-center justify-center h-full">
    <section class="flex flex-col gap-4 items-center">
      <h1 class="font-bold text-8xl">Big Data is watching YOU</h1>

      <div class="flex flex-row gap-4 mt-15">
        <Actionable xActionableOffset={10} yActionableOffset={10}>
          <a
            class="flex-col items-center p-5 border border-gray-300 rounded-lg bg-transparent inline-flex transition-shadow hover:shadow-md hover:shadow-gray-400/40"
            href="/images/myw3schoolsimage.jpg"
            download>
            <h2 class="mb-2 font-bold text-5xl in-actionable">Humans.cv</h2>
            <span class="text-sm text-center in-actionable">Organic - No updates available.</span>
          </a>
        </Actionable>

        <Actionable xActionableOffset={10} yActionableOffset={10}>
          <a
            class="flex-col items-center p-5 border border-gray-300 rounded-lg bg-transparent inline-flex transition-shadow hover:shadow-md hover:shadow-gray-400/40"
            href="/images/myw3schoolsimage.jpg"
            download>
            <h2 class="mb-2 font-bold text-5xl in-actionable">Robots.cv</h2>
            <span class="text-sm text-center in-actionable">Soulless - The robots (ATS) will be happy.</span>
          </a>
        </Actionable>
      </div>
    </section>
  </div>

  <style>
    #overlay-base {
      background-color: var(--grey-light-main);
    }
  </style>
</Layout>

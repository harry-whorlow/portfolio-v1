<div id="text-scroller">
  <p class="sr-only">Part time developer and full time procrastinator, occasionally present.</p>
  <ul class="sr-only" aria-label="Projects I contribute to">
    <li>TanStack</li>
    <li>MUI</li>
    <li>E18E</li>
    <li>Neon</li>
  </ul>

  <button type="button" class="marquee-toggle" id="marquee-toggle" aria-controls="text-scroller">
    Pause animation
  </button>

  <div class="rail" id="big" aria-hidden="true">
    <span class="big-text">PART TIME DEVELOPER</span>
    <span class="big-text text-high">&</span>
    <span class="big-text">FULL TIME PROCRASTINATOR</span>
    <span class="big-text text-low">-</span>
    <span class="big-text">OCCASIONALLY PRESENT</span>
    <span class="big-text text-mid">// &nbsp;</span>
  </div>

  <div class="rail" id="small" aria-hidden="true">
    <span class="small-text">TanStack</span>
    <span class="small-text">-</span>
    <span class="small-text">MUI</span>
    <span class="small-text">-</span>
    <span class="small-text">E18E</span>
    <span class="small-text">-</span>
    <span class="small-text">TanStack</span>
    <span class="small-text">-</span>
    <span class="small-text">Neon</span>
    <span class="small-text">-</span>
    <span class="small-text">MUI</span>
    <span class="small-text">-</span>
    <span class="small-text">E18E</span>
    <span class="small-text">-</span>
  </div>
</div>

<style>
  #text-scroller {
    position: relative;
    margin-top: 7rem;
    overflow-x: clip;
  }

  /* sits in the gap above the rails; WCAG 2.2.2 needs a way to stop anything that moves for over 5 seconds */
  .marquee-toggle {
    position: absolute;
    top: -2.75rem;
    right: 2.5rem;

    min-height: 1.5rem;
    padding: 0.25rem 0.5rem;

    font-family: 'Ingram Mono', monospace;
    font-size: 0.875rem;
    text-decoration: underline;
  }

  .marquee-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .big-text {
    font-size: 8rem;
    line-height: 8rem;
    font-weight: 600;
    font-family: 'Alliance Neue', sans-serif;
  }

  .small-text {
    font-size: 1.5rem;
    font-weight: 400;
    font-family: 'Ingram Mono', monospace;
  }

  span {
    white-space: nowrap;
    letter-spacing: ls(120);

    margin-right: 2.5rem;

    z-index: 100;
  }

  .rail {
    display: flex;
  }

  @media (width < 48rem) {
    #text-scroller {
      margin-top: 4rem;
    }

    .big-text {
      font-size: 3.5rem;
      line-height: 3.5rem;
    }

    .small-text {
      font-size: 1rem;
    }

    span {
      margin-right: 1.25rem;
    }

    .marquee-toggle {
      right: 1.25rem;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  import { horizontalLoop } from '../../utils/horizontal-loop.helper';
  import { prefersReducedMotion } from '../../utils/motion';

  type Rail = {
    el: HTMLElement;
    originals: HTMLElement[];
    config: Parameters<typeof horizontalLoop>[1];
    scrollDownTimeScale: number;
    tl?: ReturnType<typeof horizontalLoop>;
    tween?: GSAPTween;
    timeScale?: number;
  };

  const contentWidth = (rail: HTMLElement) => {
    const items = rail.children;
    const first = items[0] as HTMLElement;
    const last = items[items.length - 1] as HTMLElement;
    return last.offsetLeft + last.offsetWidth - first.offsetLeft;
  };

  // a seamless loop needs enough content to cover the viewport plus the item currently wrapping round
  const needsFill = (rail: Rail) =>
    contentWidth(rail.el) < window.innerWidth + Math.max(...rail.originals.map((item) => item.offsetWidth));

  const fillRail = (rail: Rail) => {
    while (needsFill(rail)) {
      rail.originals.forEach((item) => {
        const clone = item.cloneNode(true) as HTMLElement;
        clone.removeAttribute('style');
        clone.setAttribute('aria-hidden', 'true');
        rail.el.appendChild(clone);
      });
    }
  };

  // a whole number of loops in, so it looks like the start but a reversed rail still has room to run backwards
  const reset = (rail: Rail) => rail.tl!.pause(rail.tl!.duration() * 100);

  const buildRail = (rail: Rail) => {
    rail.tl?.destroy();
    rail.tween?.kill();

    fillRail(rail);
    rail.tl = horizontalLoop(Array.from(rail.el.children), rail.config);

    rail.tl.timeScale(rail.timeScale ?? rail.scrollDownTimeScale);
    if (!visible || paused) reset(rail);
  };

  let visible = false;
  // reduced motion starts the rails still; either way the toggle can start or stop them
  let paused = prefersReducedMotion();

  document.fonts.ready.then(() => {
    const rails: Rail[] = [
      {
        el: document.querySelector<HTMLElement>('#big')!,
        originals: gsap.utils.toArray<HTMLElement>('#big .big-text'),
        config: { repeat: -1, speed: 0.8, snap: false },
        scrollDownTimeScale: 1,
      },
      {
        el: document.querySelector<HTMLElement>('#small')!,
        originals: gsap.utils.toArray<HTMLElement>('#small .small-text'),
        config: { repeat: -1, speed: 1.2, snap: false },
        scrollDownTimeScale: -1,
      },
    ];

    rails.forEach(buildRail);

    const toggle = document.querySelector<HTMLButtonElement>('#marquee-toggle')!;
    const renderToggle = () => (toggle.textContent = paused ? 'Play animation' : 'Pause animation');
    renderToggle();

    toggle.addEventListener('click', () => {
      paused = !paused;
      renderToggle();
      rails.forEach((rail) => {
        if (paused) rail.tl!.pause();
        else if (visible) rail.tl!.resume();
      });
    });

    // the loop re-measures itself on resize, but only a rebuild can pick up newly added clones
    window.addEventListener('resize', () => {
      rails.filter(needsFill).forEach(buildRail);
    });

    // only run while on screen, and start back at the beginning each time it comes into view
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      rails.forEach((rail) => {
        if (!visible) reset(rail);
        else if (!paused) rail.tl!.resume();
      });
    }).observe(document.querySelector('#text-scroller')!);

    let scrollDirection = 1;

    // active for as long as the scroller is on screen
    ScrollTrigger.create({
      trigger: '.second-section',
      start: 'top bottom',
      end: 'bottom top',
      onUpdate: (self) => {
        if (self.direction === scrollDirection) return;
        scrollDirection = self.direction;

        rails.forEach((rail) => {
          rail.timeScale = rail.scrollDownTimeScale * scrollDirection;
          rail.tween?.kill();
          rail.tween = gsap.to(rail.tl!, { duration: 0.3, timeScale: rail.timeScale });
        });
      },
    });
  });
</script>

---
interface Props {
  company: string;
  // ISO dates (YYYY-MM-DD) render as <time>, anything else (PRESENT, FUTURE) as plain text
  dates: [string, string];
}

const { company, dates } = Astro.props;

const ISO_DATE = /^(\d{4})-(\d{2})-(\d{2})$/;

const parts = dates.map((value) => {
  const match = value.match(ISO_DATE);
  return match ? { datetime: value, label: `${match[3]}/${match[2]}/${match[1].slice(2)}` } : { label: value };
});
---

<li class="exp-job">
  <h3 class="text-2xl font-bold md:text-4xl">{company}</h3>
  <p class="mt-2 text-sm md:text-base">
    {parts.map(({ datetime, label }, i) => (
      <>
        {i > 0 && ' - '}
        {datetime ? <time datetime={datetime}>{label}</time> : label}
      </>
    ))}
  </p>
  {Astro.slots.has('default') && (
    <div class="exp-description mt-4 w-full text-sm md:w-200 md:text-base">
      <slot />
    </div>
  )}
</li>

<style>
  .exp-job {
    visibility: hidden;
  }

  .exp-description :global(> * + *) {
    margin-top: 1rem;
  }
</style>

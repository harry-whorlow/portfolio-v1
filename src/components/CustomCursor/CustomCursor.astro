---
interface Props {}
---

<div id="mouse" class="mouse-fade-animation"></div>

<div id="mouse-trailer" class="mouse-fade-animation"></div>

<style is:global>
  .mouse-fade-animation {
    position: fixed;
    left: 0;
    top: 0;

    opacity: 0;

    transition: transfrom 500ms ease;

    background-color: #fff;
    border-radius: 100%;
    mix-blend-mode: difference;

    pointer-events: none;
  }

  #mouse {
    height: 15px;
    width: 15px;

    z-index: 100;
  }

  #mouse-trailer {
    height: 10px;
    width: 10px;

    z-index: 101;
  }

  /* touch screens have no pointer to follow */
  @media (hover: none), (pointer: coarse) {
    .mouse-fade-animation {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  let isMobile = false;
  if (typeof window !== 'undefined') {
    isMobile = window.matchMedia('(hover: none), (pointer: coarse)').matches;
  }

  const mouse = window.document.getElementById('mouse');
  const mouseTrailer = window.document.getElementById('mouse-trailer');

  let pageIsActive = false;
  let passedDuration = false;
  let hasBeenCalled = false;

  setTimeout(() => {
    passedDuration = true;
  }, 1000);

  const fadeInTimeline = gsap.timeline({ paused: true }).to('.mouse-fade-animation', { opacity: 1, duration: 4 });

  const CHASE_SPRING = { stiffness: 90, damping: 7 };
  const MAGNET_SPRING = { stiffness: 160, damping: 12 };
  const COLLISION_BOUNCE = 0.4;
  const MAX_STRETCH = 0.35;

  // all positions are element centres
  const pointer = { x: 0, y: 0 };
  const trailer = { x: 0, y: 0, vx: 0, vy: 0 };
  let magnetTarget: { x: number; y: number } | null = null;
  let initialised = false;
  let rafId: number | null = null;
  let lastTime = 0;

  const getMagnetTarget = (target: Element) => {
    const rect = target.getBoundingClientRect();

    const actionableXOffset = target.getAttribute('actionable-x-offset');
    const actionableYOffset = target.getAttribute('actionable-y-offset');

    const anchorX = actionableXOffset ? rect.x + parseInt(actionableXOffset) : rect.x;
    const anchorY = actionableYOffset ? rect.y + parseInt(actionableYOffset) : rect.y;

    const maxPull = 10;

    // mouse position relative to rect
    const localX = pointer.x - rect.left;
    const localY = pointer.y - rect.top;

    // anchor position relative to rect
    const anchorLocalX = anchorX - rect.left;
    const anchorLocalY = anchorY - rect.top;

    // distances from anchor to edges
    const leftDist = anchorLocalX;
    const rightDist = rect.width - anchorLocalX;
    const topDist = anchorLocalY;
    const bottomDist = rect.height - anchorLocalY;

    let pullX = 0;
    let pullY = 0;

    if (localX < anchorLocalX) {
      const ratio = (localX - anchorLocalX) / leftDist; // ratio in [-1, 0]
      pullX = ratio * maxPull;
    } else if (localX > anchorLocalX) {
      const ratio = (localX - anchorLocalX) / rightDist; // ratio in [0, 1]
      pullX = ratio * maxPull;
    }

    if (localY < anchorLocalY) {
      const ratio = (localY - anchorLocalY) / topDist; // [-1, 0]
      pullY = ratio * maxPull;
    } else if (localY > anchorLocalY) {
      const ratio = (localY - anchorLocalY) / bottomDist; // [0, 1]
      pullY = ratio * maxPull;
    }

    return { x: anchorX + pullX, y: anchorY + pullY };
  };

  const tick = (time: number) => {
    if (!mouse || !mouseTrailer) return;

    const dt = Math.min((time - lastTime) / 1000, 1 / 30);
    lastTime = time;

    const trailerRadius = mouseTrailer.offsetWidth / 2;
    const restDistance = mouse.offsetWidth / 2 + trailerRadius;

    let dx = trailer.x - pointer.x;
    let dy = trailer.y - pointer.y;
    let distance = Math.hypot(dx, dy) || 1;

    const target = magnetTarget ?? {
      x: pointer.x + (dx / distance) * restDistance,
      y: pointer.y + (dy / distance) * restDistance,
    };
    const spring = magnetTarget ? MAGNET_SPRING : CHASE_SPRING;

    trailer.vx += (spring.stiffness * (target.x - trailer.x) - spring.damping * trailer.vx) * dt;
    trailer.vy += (spring.stiffness * (target.y - trailer.y) - spring.damping * trailer.vy) * dt;
    trailer.x += trailer.vx * dt;
    trailer.y += trailer.vy * dt;

    if (!magnetTarget) {
      dx = trailer.x - pointer.x;
      dy = trailer.y - pointer.y;
      distance = Math.hypot(dx, dy) || 1;

      if (distance < restDistance) {
        const nx = dx / distance;
        const ny = dy / distance;

        trailer.x = pointer.x + nx * restDistance;
        trailer.y = pointer.y + ny * restDistance;

        const inward = trailer.vx * nx + trailer.vy * ny;
        if (inward < 0) {
          trailer.vx -= (1 + COLLISION_BOUNCE) * inward * nx;
          trailer.vy -= (1 + COLLISION_BOUNCE) * inward * ny;
        }
      }
    }

    const speed = Math.hypot(trailer.vx, trailer.vy);
    const stretch = Math.min(speed / 2000, MAX_STRETCH);
    const angle = Math.atan2(trailer.vy, trailer.vx);

    mouseTrailer.style.transform =
      `translate(${trailer.x - trailerRadius}px, ${trailer.y - trailerRadius}px) ` +
      `rotate(${angle}rad) scale(${1 + stretch}, ${1 - stretch / 2})`;

    const settled = speed < 0.5 && Math.hypot(target.x - trailer.x, target.y - trailer.y) < 0.5;
    rafId = settled ? null : requestAnimationFrame(tick);
  };

  const startLoop = () => {
    if (rafId !== null) return;
    lastTime = performance.now();
    rafId = requestAnimationFrame(tick);
  };

  if (!isMobile) {
    // hover elements
    document.addEventListener(
      'mousemove',
      (e) => {
        if (!mouse || !mouseTrailer) return;

        // fade in
        pageIsActive = true;
        if (pageIsActive && passedDuration && !hasBeenCalled) {
          fadeInTimeline.play();
          hasBeenCalled = true;
        }

        // position mouse cross
        const mouseX = e.clientX - mouse.offsetWidth / 2;
        const mouseY = e.clientY - mouse.offsetHeight / 2;
        mouse.style.left = `${mouseX}px`;
        mouse.style.top = `${mouseY}px`;

        pointer.x = e.clientX;
        pointer.y = e.clientY;

        // start the trailer resting just below the mouse
        if (!initialised) {
          trailer.x = pointer.x;
          trailer.y = pointer.y + mouse.offsetWidth / 2 + mouseTrailer.offsetWidth / 2;
          initialised = true;
        }

        const underMouse = document.elementFromPoint(e.clientX, e.clientY);
        const actionableTarget = underMouse ? underMouse.closest('.actionable') : null;
        magnetTarget = actionableTarget ? getMagnetTarget(actionableTarget) : null;

        startLoop();
      },
      { passive: true }
    );
  }
</script>

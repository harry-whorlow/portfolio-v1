---
interface Props {
  colors: string[];
}

const { colors } = Astro.props;
---

<div class="progress-bars" aria-hidden="true">
  {colors.map((color) => (
    <div class="progress-bar" style={`--bar-color: ${color}`} />
  ))}
</div>

<style>
  .progress-bars {
    position: absolute;
    right: 0;
    bottom: 2rem;
    left: 0;

    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    pointer-events: none;
  }

  .progress-bar {
    height: 2px;
    width: 100%;

    background-color: var(--bar-color);

    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }
</style>

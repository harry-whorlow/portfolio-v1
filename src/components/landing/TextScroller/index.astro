<div>
  <div class="rail" id="big">
    <span class="big-text">PART TIME DEVELOPER</span>
    <span class="big-text">&</span>
    <span class="big-text">FULL TIME PROCRASTINATOR</span>
    <span class="big-text">-</span>
    <span class="big-text">OCCASIONALLY PRESENT</span>
    <span class="big-text">// &nbsp</span>
  </div>

  <div class="rail" id="small">
    <span class="small-text">Python</span>
    <span class="small-text">-</span>
    <span class="small-text">JavaScript</span>
    <span class="small-text">-</span>
    <span class="small-text">Go Lang</span>
    <span class="small-text">-</span>
    <span class="small-text">TypeScript</span>
    <span class="small-text">-</span>
    <span class="small-text">Python</span>
    <span class="small-text">-</span>
    <span class="small-text">JavaScript</span>
    <span class="small-text">-</span>
    <span class="small-text">Go Lang</span>
    <span class="small-text">-</span>
    <span class="small-text">TypeScript</span>
    <span class="small-text">- &nbsp</span>
  </div>
</div>

<style>
  .big-text {
    font-size: 100px;
    font-weight: 400;
    font-family: 'Alliance Neue', sans-serif;
  }

  .small-text {
    font-size: 40px;
    font-weight: 400;
    font-family: 'Ingram Mono', monospace;
  }

  span {
    white-space: nowrap;

    letter-spacing: ls(120);
    line-height: 1em;

    margin-right: 2.5rem;

    color: var(--main-text-light);

    z-index: 100;
  }

  .rail {
    display: flex;
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  import { horizontalLoop } from '../../../utils/horizontal-loop.helper';

  document.fonts.ready.then(() => {
    const scrollingText = gsap.utils.toArray<Element>('#big .big-text');
    const smallScrollingText = gsap.utils.toArray<Element>('#small .small-text');

    // big timeline
    const BigTl = horizontalLoop(scrollingText, {
      paused: true,
      repeat: -1,
      speed: 0.5,
      snap: false,
    });

    let bigDirection = 1;
    let BigT: GSAPTween;

    ScrollTrigger.create({
      trigger: '#overlay-secondary',
      start: 'top top',
      end: 'bottom top',
      onUpdate: (self) => {
        if (self.direction !== bigDirection) {
          bigDirection = self.direction;
          BigT && BigT.kill();
          BigT = gsap.to(BigTl, {
            duration: 0.3,
            timeScale: self.direction,
          });
        }
      },
    });

    ScrollTrigger.create({
      trigger: '.second-section',
      start: 'top center',
      end: 'bottom bottom',
      onEnter: () => BigTl.play(),
      onLeave: () => BigTl.pause(),
    });

    //small timeline
    const smallTl = horizontalLoop(smallScrollingText, {
      repeat: -1,
      speed: 1,
      snap: false,
      reversed: true,
    });

    let smallDirection = -1;
    let smallT: GSAPTween;

    ScrollTrigger.create({
      trigger: '#overlay-secondary',
      start: 'top top',
      end: 'bottom top',
      onUpdate: (self) => {
        if (self.direction !== smallDirection) {
          smallDirection = self.direction;
          smallT && smallT.kill();
          smallT = gsap.to(smallTl, {
            duration: 0.3,
            timeScale: self.direction * -1,
          });
        }
      },
    });
  });
</script>

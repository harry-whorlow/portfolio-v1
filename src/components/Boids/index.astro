---
import { RAMP } from '../../three/palette';

interface Props {
  colors?: string[];
  count?: number;
  hidden?: boolean;
}

// low, mid and high elevation, matching the progress bars and the experience lines
const { colors = [RAMP[2], RAMP[4], RAMP[6]], count, hidden = false } = Astro.props;
---

<div class="boids" data-boids data-colors={JSON.stringify(colors)} data-count={count} data-hidden={String(hidden)}>
  <div class="boids-viewport" aria-hidden="true">
    <canvas class="boids-canvas"></canvas>
  </div>
</div>

<style>
  .boids {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition:
      opacity 0.6s ease,
      visibility 0.6s;
  }

  .boids[data-hidden='true'] {
    opacity: 0;
    visibility: hidden;
  }

  /* one viewport tall, moved by script over the part of the host on screen: ScrollSmoother's transform breaks fixed and sticky */
  .boids-viewport {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    will-change: transform;
  }

  .boids-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { createBoids } from './boids';
  import { animationsPaused, onAnimationsPaused } from '../../utils/animations';

  document.querySelectorAll<HTMLElement>('[data-boids]').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('.boids-canvas')!;

    const boids = createBoids(canvas, {
      host: root,
      follow: Array.from(root.querySelectorAll<HTMLElement>('.boids-viewport')),
      colors: JSON.parse(root.dataset.colors!),
      count: root.dataset.count ? Number(root.dataset.count) : undefined,
      paused: animationsPaused(),
      hidden: root.dataset.hidden === 'true',
    });

    const sync = () => {
      root.dataset.paused = String(boids.paused);
      root.dataset.hidden = String(boids.hidden);
    };

    const on = (event: string, action: () => void) => root.addEventListener(event, () => (action(), sync()));
    on('boids:play', boids.play);
    on('boids:pause', boids.pause);
    on('boids:toggle', boids.toggle);
    on('boids:hide', boids.hide);
    on('boids:show', boids.show);

    onAnimationsPaused((paused) => {
      if (paused) boids.pause();
      else boids.play();
      sync();
    });
  });
</script>
